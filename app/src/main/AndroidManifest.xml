<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 网络（仅 AI 助手模块使用） ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ===== 应用使用统计（监护：统计各应用前台时长） ===== -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===== 悬浮窗（超时全屏提醒） ===== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ===== 前台服务（保活限制策略） ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- ===== 相机（AI 聊天 / 家庭聊天图片消息） ===== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ===== 保存聊天图片到相册（仅 Android 9 及以下需要；Android 10+ 走 MediaStore 免权限） ===== -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ===== 通知（API 33+ 动态申请） ===== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== 开机自启（重启后恢复限制服务） ===== -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ===== 唤醒锁（前台服务计时） ===== -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ===== 查询设备上已安装应用（用于应用列表与分类，本应用为侧载安装，非 Play 上架） ===== -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".BuddyStudyGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuddyStudyGuard"
        tools:targetApi="34">

        <!-- 主 Activity（单 Activity + Compose 导航） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BuddyStudyGuard.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：保活后台时长统计与限制策略 -->
        <service
            android:name=".monitor.service.AppLimitForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="学习监护：统计应用使用时长并在超限时提醒，所有数据仅存本地，不上传任何信息。" />
        </service>

        <!-- 无障碍服务：仅用于在命中限制时执行「返回桌面」动作，不读取任何界面内容 -->
        <service
            android:name=".monitor.service.AppLimitAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机自启接收器：重启后恢复前台监护服务 -->
        <receiver
            android:name=".monitor.service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 关闭 WorkManager 默认初始化（改由 Hilt 在 Application 中提供 Configuration） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FileProvider：为相机拍照提供临时文件 URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 豆包 API Key（在 app/build.gradle.kts 通过 manifestPlaceholders 注入） -->
        <meta-data
            android:name="com.buddy.studyguard.DOUBAO_API_KEY"
            android:value="${DOUBAO_API_KEY}" />

        <!-- 全屏拦截提醒 Activity：在超时/禁用时段/即时锁定时弹出 -->
        <activity
            android:name=".monitor.service.FullScreenAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

    </application>

</manifest>
